{
  "version": 2,
  "cleanUrls": true,
  "public": true,
  "routes": [
    {
      "src": "/api/masjidlar",
      "dest": "/app_web/data/masjidlar.json",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Content-Type": "application/json; charset=utf-8"
      }
    },
    {
      "src": "/MasjidNamozVaqtlari.ipa",
      "dest": "/app_web/MasjidNamozVaqtlari.ipa",
      "headers": {
        "Content-Type": "application/octet-stream"
      }
    },
    {
      "src": "/MasjidNamozVaqtlari.mobileconfig",
      "dest": "/app_web/MasjidNamozVaqtlari.mobileconfig",
      "headers": {
        "Content-Type": "application/x-apple-aspen-config"
      }
    },
    {
      "src": "/admin",
      "dest": "/app_web/admin.html"
    },
    {
      "src": "/sw.js",
      "dest": "/app_web/sw.js",
      "headers": {
        "Service-Worker-Allowed": "/",
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "/app_web/manifest.json",
      "headers": {
        "Content-Type": "application/manifest+json"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/app_web/$1"
    }
  ]
}
